# Compilaciones locales de CMake
/build/
/build-*/
/cmake-build-*/
/CMakeUserPresets.json
/compile_commands.json

# Downloaded real embeddings and generated evaluation artifacts
/datasets/real/dbpedia/
__pycache__/

# Archivos locales del sistema
.DS_Store
Thumbs.db

# Compiled objects/binaries must never be versioned (they break clean checkouts)
*.obj
*.o
*.exe

# Optimization-phase public datasets (downloaded on demand)
/datasets/real/dbpedia-100k/
/datasets/real/sift1m/

# Market comparison (local tools, data and environment)
/.venv-bench/
/datasets/market/
/tools/
# Raw TREC runs and ground-truth vectors (~1.9 GB, regenerated by run_market_campaign.py);
# summaries, per-query latencies, manifests and logs stay in Git.
/evaluation/reports/market/**/*.run
/evaluation/reports/market/**/*.ivecs

# Editor/IDE settings are personal
/.vscode/
/.idea/

# Raw run evidence stays local: logs, CMake caches, assembly dumps and intermediate
# benchmark passes. Reports, summaries and the CSV/JSON results they cite are tracked.
/docs/**/*.log
/docs/**/CMakeCache.txt
/docs/**/*.s
/docs/**/*.zip
/docs/**/*stderr.txt
/docs/reports/evidence/2026-10-19-optimization/initial-byte-visited/
/docs/reports/evidence/2026-10-19-optimization/packed-memory-intermediate/
/docs/reports/evidence/2026-10-19-optimization/sanitizers_initial/
/evaluation/**/*.log
/evaluation/reports/market/ann-pass1/
/evaluation/reports/market/beir-ann-pass1/
/evaluation/reports/market/manifest-pass*.json
/evaluation/reports/market/done.txt
# The hybrid checklist report links its logs directly, so that folder is kept whole.
!/docs/reports/evidence/2026-10-30-hybrid-checklist/**

cmake_minimum_required(VERSION 3.20)
# Phase 6: --filter through the executable. Every returned document must carry the
# requested metadata; option errors exit 2 and unknown fields exit 3.
set(D "${SOURCE_DIR}/datasets")

function(run_cli expected)
    execute_process(COMMAND "${CLI_PATH}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${output}\n${errors}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

# Documents per topic, read from the fixture itself. Texts contain ';' (CMake's list
# separator), so read the whole file, neutralize it and match line by line.
file(READ "${D}/hybrid/corpus.jsonl" content)
string(REPLACE ";" "," content "${content}")
string(REGEX MATCHALL "\"document_id\":\"D[0-9]+\"[^\n]*\"metadata\":\\{\"topic\":\"(hnsw|rrf)\"\\}"
    matches "${content}")
set(allowed "")
foreach(match IN LISTS matches)
    string(REGEX MATCH "^\"document_id\":\"(D[0-9]+)\"" ignored "${match}")
    list(APPEND allowed "${CMAKE_MATCH_1}")
endforeach()
list(LENGTH allowed expected_matches)

function(check_results label)
    string(REPLACE "\n" ";" rows "${cli_output}")
    set(seen 0)
    foreach(row IN LISTS rows)
        if(row MATCHES "^\\| +[0-9]+ \\| +(D[0-9]+) \\|")
            if(NOT "${CMAKE_MATCH_1}" IN_LIST allowed)
                message(FATAL_ERROR "${label}: ${CMAKE_MATCH_1} is outside the filter\n${cli_output}")
            endif()
            math(EXPR seen "${seen}+1")
        endif()
    endforeach()
    if(seen EQUAL 0)
        message(FATAL_ERROR "${label}: no results\n${cli_output}")
    endif()
    string(FIND "${cli_output}" "matching documents: ${expected_matches} of 30" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${label}: filter summary missing\n${cli_output}")
    endif()
endfunction()

set(F --filter "topic=hnsw|rrf")
run_cli(0 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q003 --k 10 ${F})
check_results(hybrid)
string(FIND "${cli_output}" "Dense filter strategy: exact search over matching vectors" exact)
if(exact EQUAL -1)
    message(FATAL_ERROR "Small filtered set should use the exact dense strategy")
endif()
run_cli(0 search --mode lexical --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 ${F} --bm25-strategy bmw)
check_results(lexical)
run_cli(0 search --algorithm hnsw --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 ${F} --quantization sq8)
check_results(vector-hnsw-sq8)
run_cli(0 search --algorithm brute-force --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 ${F})
check_results(vector-brute-force)
run_cli(0 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --all-queries --query-threads 4 ${F})
check_results(hybrid-batch)

run_cli(3 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 --filter region=eu)
run_cli(2 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 --filter topic)
run_cli(2 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 --filter-date topic=2026-02-30..)
run_cli(2 search --algorithm brute-force --dataset "${D}/examples/vectors.csv" --query "${D}/examples/query.csv" --filter topic=hnsw)
message(STATUS "Filtered CLI: ${expected_matches} matching documents enforced in every mode")

# Shared assertions for the human-readable search response.
string(REPEAT "[0-9]" 9 distance_decimals)
set(cli_row_pattern "^\\| +([0-9]+) +\\| +([0-9]+) +\\| +([0-9]+\\.${distance_decimals}) +\\|$")

function(parse_cli_row row)
    if(NOT row MATCHES "${cli_row_pattern}")
        message(FATAL_ERROR "Expected integer rank/ID and exactly nine distance decimals: ${row}")
    endif()
    set(cli_rank "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(cli_id "${CMAKE_MATCH_2}" PARENT_SCOPE)
    set(cli_distance "${CMAKE_MATCH_3}" PARENT_SCOPE)
endfunction()

function(check_search_output output expected_count)
    if(NOT output MATCHES "Query time \\(ms\\): [0-9]+\\.[0-9][0-9][0-9][0-9][0-9][0-9]\n" OR
       NOT output MATCHES "Query time scope: search only \\(excludes CSV loading\\)")
        message(FATAL_ERROR "Missing finite nonnegative query time and its scope: ${output}")
    endif()
    string(REPLACE "\n" ";" lines "${output}")
    set(rows "")
    set(border "")
    set(expect_border TRUE)
    set(header_seen FALSE)
    set(border_count 0)
    foreach(line IN LISTS lines)
        if(line MATCHES "^\\+[-+]+\\+$")
            if(NOT expect_border)
                message(FATAL_ERROR "Unexpected table separator: ${output}")
            endif()
            if(border STREQUAL "")
                set(border "${line}")
                string(LENGTH "${border}" table_width)
            elseif(NOT line STREQUAL border)
                message(FATAL_ERROR "Table separators must have identical column widths: ${output}")
            endif()
            math(EXPR border_count "${border_count} + 1")
            set(expect_border FALSE)
        elseif(line MATCHES "^\\|")
            string(LENGTH "${line}" row_width)
            if(expect_border OR border STREQUAL "" OR NOT row_width EQUAL table_width)
                message(FATAL_ERROR "Every aligned row must be separated by a horizontal line: ${output}")
            endif()
            # Each vertical column separator must align with the corresponding '+' in the border.
            math(EXPR last_column "${table_width} - 1")
            foreach(column RANGE 0 ${last_column})
                string(SUBSTRING "${line}" ${column} 1 cell)
                string(SUBSTRING "${border}" ${column} 1 edge)
                if((cell STREQUAL "|" AND NOT edge STREQUAL "+") OR
                   (edge STREQUAL "+" AND NOT cell STREQUAL "|"))
                    message(FATAL_ERROR "Misaligned table columns: ${output}")
                endif()
            endforeach()
            if(NOT header_seen)
                if(NOT line MATCHES "^\\| Rank +\\| Vector ID +\\| Distance +\\|$")
                    message(FATAL_ERROR "Incorrect table header: ${line}")
                endif()
                set(header_seen TRUE)
            else()
                parse_cli_row("${line}")
                list(APPEND rows "${line}")
            endif()
            set(expect_border TRUE)
        endif()
    endforeach()
    list(LENGTH rows count)
    math(EXPR expected_borders "${expected_count} + 2")
    if(NOT header_seen OR NOT count EQUAL expected_count OR
       NOT border_count EQUAL expected_borders OR expect_border)
        message(FATAL_ERROR "Incorrect table rows or horizontal separators: ${output}")
    endif()
    set(cli_rows "${rows}" PARENT_SCOPE)
endfunction()

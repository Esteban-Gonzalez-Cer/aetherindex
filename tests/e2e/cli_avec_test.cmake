cmake_minimum_required(VERSION 3.20)
# Phase 1: `convert` + .avec inputs must give byte-identical search output (timings
# excluded) to the CSV/JSONL inputs they came from, and reject invalid combinations.
file(MAKE_DIRECTORY "${WORK_DIR}")
set(D "${SOURCE_DIR}/datasets")
execute_process(COMMAND "${GENERATOR_PATH}" "${WORK_DIR}/mvp" RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Fixture generation failed")
endif()

function(run_cli expected)
    execute_process(COMMAND "${CLI_PATH}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${output}\n${errors}")
    endif()
    if(NOT expected EQUAL 0 AND (NOT output STREQUAL "" OR errors STREQUAL ""))
        message(FATAL_ERROR "Failure printed partial output or no error: ${ARGN}")
    endif()
    string(REGEX REPLACE "[^\n]*time \\(ms\\):[^\n]*\n" "" output "${output}")
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

function(require_same label)
    if(NOT first STREQUAL cli_output)
        message(FATAL_ERROR "${label}: .avec output differs\n--- text input\n${first}\n--- .avec\n${cli_output}")
    endif()
endfunction()

run_cli(0 convert --dataset "${D}/examples/vectors.csv" --out "${WORK_DIR}/examples.avec")
run_cli(0 convert --dataset "${WORK_DIR}/mvp/vectors.csv" --out "${WORK_DIR}/mvp.avec")
run_cli(0 convert --dataset "${D}/hybrid/corpus.jsonl" --out "${WORK_DIR}/hybrid.avec"
    --documents-out "${WORK_DIR}/hybrid-text.jsonl")
string(FIND "${cli_output}" "Documents written (text only): 30" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Conversion summary missing: ${cli_output}")
endif()

foreach(metric cosine squared-euclidean)
    foreach(algorithm brute-force hnsw)
        run_cli(0 search --algorithm ${algorithm} --metric ${metric} --dataset "${D}/examples/vectors.csv" --query "${D}/examples/query.csv" --k 4)
        set(first "${cli_output}")
        run_cli(0 search --algorithm ${algorithm} --metric ${metric} --dataset "${WORK_DIR}/examples.avec" --query "${D}/examples/query.csv" --k 4)
        require_same("examples ${algorithm} ${metric}")
        foreach(q 0 4 9)
            run_cli(0 search --algorithm ${algorithm} --metric ${metric} --dataset "${WORK_DIR}/mvp/vectors.csv" --query "${WORK_DIR}/mvp/query_${q}.csv" --k 10)
            set(first "${cli_output}")
            run_cli(0 search --algorithm ${algorithm} --metric ${metric} --dataset "${WORK_DIR}/mvp.avec" --query "${WORK_DIR}/mvp/query_${q}.csv" --k 10)
            require_same("mvp ${algorithm} ${metric} query ${q}")
        endforeach()
    endforeach()
endforeach()

# Hybrid: text documents + .avec reproduce JSONL-with-embeddings for every query.
file(STRINGS "${D}/hybrid/queries.jsonl" query_lines)
set(compared 0)
foreach(line IN LISTS query_lines)
    if(line MATCHES "\"query_id\":\"([^\"]+)\"")
        run_cli(0 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id ${CMAKE_MATCH_1})
        set(first "${cli_output}")
        run_cli(0 search --mode hybrid --dataset "${WORK_DIR}/hybrid-text.jsonl" --vectors "${WORK_DIR}/hybrid.avec" --query "${D}/hybrid/queries.jsonl" --query-id ${CMAKE_MATCH_1})
        require_same("hybrid ${CMAKE_MATCH_1}")
        math(EXPR compared "${compared}+1")
    endif()
endforeach()
# An .avec dataset also accepts a JSONL query with an embedding.
run_cli(0 search --algorithm brute-force --dataset "${WORK_DIR}/hybrid.avec" --query "${D}/hybrid/queries.jsonl" --query-id Q001 --k 3)

# Invalid combinations (2) and invalid data (3).
run_cli(2 convert --dataset "${D}/examples/vectors.csv" --out "${WORK_DIR}/x.bin")
run_cli(2 convert --dataset "${D}/examples/vectors.csv" --out "${WORK_DIR}/x.avec" --documents-out "${WORK_DIR}/x.jsonl")
run_cli(2 convert --dataset "${D}/examples/vectors.csv")
run_cli(3 convert --dataset "${WORK_DIR}/missing.csv" --out "${WORK_DIR}/x.avec")
run_cli(3 convert --dataset "${D}/corpus.jsonl" --out "${WORK_DIR}/x.avec")
run_cli(2 search --algorithm hnsw --dataset "${D}/examples/vectors.csv" --query "${D}/examples/query.csv" --vectors "${WORK_DIR}/examples.avec")
run_cli(2 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --vectors "${D}/examples/vectors.csv" --query "${D}/hybrid/queries.jsonl" --query-id Q001)
run_cli(2 search --algorithm brute-force --dataset "${D}/examples/vectors.csv" --query "${WORK_DIR}/examples.avec")
run_cli(3 search --mode hybrid --dataset "${WORK_DIR}/hybrid-text.jsonl" --vectors "${WORK_DIR}/examples.avec" --query "${D}/hybrid/queries.jsonl" --query-id Q001)
run_cli(3 search --algorithm brute-force --dataset "${WORK_DIR}/examples.avec" --query "${WORK_DIR}/mvp/query_0.csv")
message(STATUS ".avec CLI: ${compared} hybrid queries and all vector cases identical")

cmake_minimum_required(VERSION 3.20)
# Phase 2: every --all-queries block (any --query-threads) must equal the single-query
# report for that query, and --parallel-retrievers must not change any result.
file(MAKE_DIRECTORY "${WORK_DIR}")
set(D "${SOURCE_DIR}/datasets")

function(run_cli expected)
    execute_process(COMMAND "${CLI_PATH}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${errors}")
    endif()
    string(REGEX REPLACE "[^\n]*time \\(ms\\):[^\n]*\n" "" output "${output}")
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

# Body of a single-query report, without the shared banner and trailer.
function(single_body out)
    run_cli(0 ${ARGN})
    string(REPLACE "AetherIndex Search\n\n" "" body "${cli_output}")
    string(REPLACE "\nSearch completed successfully.\n" "" body "${body}")
    set(${out} "${body}" PARENT_SCOPE)
endfunction()

function(check_batch label)
    file(STRINGS "${D}/hybrid/queries.jsonl" lines)
    set(ids "")
    foreach(line IN LISTS lines)
        if(line MATCHES "\"query_id\":\"([^\"]+)\"")
            list(APPEND ids "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(LENGTH ids count)
    foreach(threads 1 4)
        run_cli(0 ${ARGN} --all-queries --query-threads ${threads})
        set(batch "${cli_output}")
        string(FIND "${batch}" "Batch queries: ${count}\n" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "${label}: batch header missing\n${batch}")
        endif()
        set(index 0)
        foreach(id IN LISTS ids)
            math(EXPR index "${index}+1")
            math(EXPR next "${index}+1")
            set(marker "\n=== Query ${index}/${count} ===\n")
            string(FIND "${batch}" "${marker}" begin)
            if(begin EQUAL -1)
                message(FATAL_ERROR "${label}: missing block ${index}")
            endif()
            string(LENGTH "${marker}" marker_length)
            math(EXPR begin "${begin}+${marker_length}")
            if(index EQUAL count)
                string(FIND "${batch}" "\nSearch completed successfully.\n" end)
            else()
                string(FIND "${batch}" "\n=== Query ${next}/${count} ===\n" end)
            endif()
            math(EXPR length "${end}-${begin}")
            string(SUBSTRING "${batch}" ${begin} ${length} block)
            single_body(expected ${ARGN} --query-id ${id})
            if(NOT block STREQUAL expected)
                message(FATAL_ERROR "${label} threads=${threads} ${id}: batch block differs\n--- batch\n${block}\n--- single\n${expected}")
            endif()
        endforeach()
    endforeach()
endfunction()

check_batch(hybrid search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --k 5)
check_batch(lexical search --mode lexical --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --k 5)
check_batch(vector search --algorithm hnsw --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --k 5)

# Concurrent retrievers give the same report as sequential retrievers.
foreach(id Q001 Q009 Q024)
    single_body(sequential search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id ${id})
    single_body(concurrent search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id ${id} --parallel-retrievers)
    if(NOT sequential STREQUAL concurrent)
        message(FATAL_ERROR "--parallel-retrievers changed ${id}")
    endif()
endforeach()
# Phase 5: every BM25 strategy yields the exhaustive reports (strategy line aside).
foreach(mode lexical hybrid)
    run_cli(0 search --mode ${mode} --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --all-queries --k 10)
    string(REGEX REPLACE "Batch time \\(ms\\)[^\n]*\n|Throughput[^\n]*\n" "" reference "${cli_output}")
    foreach(strategy taat wand bmw maxscore)
        run_cli(0 search --mode ${mode} --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --all-queries --k 10 --bm25-strategy ${strategy})
        string(REGEX REPLACE "Batch time \\(ms\\)[^\n]*\n|Throughput[^\n]*\n|BM25 strategy:[^\n]*\n" "" variant "${cli_output}")
        if(NOT variant STREQUAL reference)
            message(FATAL_ERROR "--bm25-strategy ${strategy} changed ${mode} results")
        endif()
    endforeach()
endforeach()
run_cli(2 search --mode lexical --dataset "${D}/corpus.jsonl" --query-text motor --bm25-strategy blockmax)
run_cli(2 search --algorithm hnsw --dataset "${D}/examples/vectors.csv" --query "${D}/examples/query.csv" --bm25-strategy bmw)

# A parallel graph build still completes the full hybrid path.
run_cli(0 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --all-queries --build-threads 4 --query-threads 4)

run_cli(2 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 --query-threads 4)
run_cli(2 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --query-id Q001 --all-queries)
run_cli(2 search --algorithm brute-force --dataset "${D}/examples/vectors.csv" --query "${D}/examples/query.csv" --build-threads 4)
run_cli(2 search --mode lexical --dataset "${D}/corpus.jsonl" --query "${D}/queries.jsonl" --query-id Q001 --parallel-retrievers)
run_cli(2 search --algorithm brute-force --dataset "${D}/examples/vectors.csv" --query "${D}/examples/query.csv" --all-queries)
run_cli(2 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --all-queries --query-threads 0)
run_cli(2 search --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl" --all-queries --all-queries)
message(STATUS "Batch CLI: hybrid, lexical and vector blocks identical to single-query reports")

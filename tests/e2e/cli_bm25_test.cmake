cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${WORK_DIR}")
set(dataset "${WORK_DIR}/documents with spaces.jsonl")
set(query "${WORK_DIR}/queries with spaces.jsonl")
file(WRITE "${dataset}" "{\"document_id\":101,\"text\":\"radio radio dish\",\"embedding\":null}\n{\"document_id\":102,\"text\":\"radio wave\"}\n{\"document_id\":103,\"text\":\"mirror\"}\n")
file(WRITE "${query}" "{\"query_id\":\"Q1\",\"query_text\":\"radio\",\"relevant_document_ids\":[103]}\n{\"query_id\":\"Q2\",\"query_text\":\"mirror\"}\n")

function(run_cli expected)
    execute_process(COMMAND "${CLI_PATH}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${output}\n${errors}")
    endif()
    string(REPLACE "\r\n" "\n" output "${output}")
    if(expected EQUAL 0)
        if(NOT errors STREQUAL "")
            message(FATAL_ERROR "Success wrote diagnostics: ${errors}")
        endif()
    elseif(NOT output STREQUAL "" OR errors STREQUAL "")
        message(FATAL_ERROR "Failure printed partial results or no error: ${output}\n${errors}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
    set(cli_error "${errors}" PARENT_SCOPE)
endfunction()

function(check_table count)
    string(REPLACE "\n" ";" lines "${cli_output}")
    set(border "")
    set(borders 0)
    set(rows 0)
    set(expect_border TRUE)
    set(header FALSE)
    foreach(line IN LISTS lines)
        if(line MATCHES "^\\+[-+]+\\+$")
            if(NOT expect_border)
                message(FATAL_ERROR "Missing row between borders: ${cli_output}")
            endif()
            if(border STREQUAL "")
                set(border "${line}")
                string(LENGTH "${border}" width)
            elseif(NOT border STREQUAL line)
                message(FATAL_ERROR "Unequal borders: ${cli_output}")
            endif()
            math(EXPR borders "${borders}+1")
            set(expect_border FALSE)
        elseif(line MATCHES "^\\|")
            string(LENGTH "${line}" row_width)
            if(expect_border OR NOT row_width EQUAL width)
                message(FATAL_ERROR "Misaligned row: ${line}")
            endif()
            math(EXPR last "${width}-1")
            foreach(column RANGE 0 ${last})
                string(SUBSTRING "${line}" ${column} 1 cell)
                string(SUBSTRING "${border}" ${column} 1 edge)
                if((cell STREQUAL "|" AND NOT edge STREQUAL "+") OR
                   (edge STREQUAL "+" AND NOT cell STREQUAL "|"))
                    message(FATAL_ERROR "Invalid vertical separators: ${line}")
                endif()
            endforeach()
            if(NOT header)
                if(NOT line MATCHES "^\\| Rank +\\| Document ID +\\| BM25 Score +\\|$")
                    message(FATAL_ERROR "Wrong lexical column labels: ${line}")
                endif()
                set(header TRUE)
            else()
                string(REPEAT "[0-9]" 9 decimals)
                if(NOT line MATCHES "^\\| +([0-9]+) +\\| +([^|]+) +\\| +([0-9]+\\.${decimals}) +\\|$")
                    message(FATAL_ERROR "Expected nine score decimals: ${line}")
                endif()
                math(EXPR rows "${rows}+1")
                if(NOT CMAKE_MATCH_1 EQUAL rows)
                    message(FATAL_ERROR "Incorrect rank: ${line}")
                endif()
            endif()
            set(expect_border TRUE)
        endif()
    endforeach()
    math(EXPR expected_borders "${count}+2")
    if(NOT rows EQUAL count OR NOT borders EQUAL expected_borders OR expect_border)
        message(FATAL_ERROR "Incorrect table boundaries or count: ${cli_output}")
    endif()
endfunction()

set(search search --algorithm bm25 --dataset "${dataset}" --query "${query}")
run_cli(3 ${search})
if(NOT cli_error MATCHES "--query-id")
    message(FATAL_ERROR "Multiple queries require explicit selection: ${cli_error}")
endif()
run_cli(0 ${search} --query-id Q1 --k 100)
foreach(fragment "Algorithm: BM25" "Documents indexed: 3" "Results returned: 2" "Query ID: Q1"
                 "BM25 configuration: k1=1.2 b=0.75" "lexical indexing" "BM25 search only")
    if(NOT cli_output MATCHES "${fragment}")
        message(FATAL_ERROR "Missing BM25 metadata ${fragment}: ${cli_output}")
    endif()
endforeach()
if(cli_output MATCHES "Vector ID|Distance metric|Dimensions:|HNSW configuration")
    message(FATAL_ERROR "Vector labels leaked into BM25 output: ${cli_output}")
endif()
if(NOT cli_output MATCHES "101 +\\| +0.566579717" OR NOT cli_output MATCHES "102 +\\| +0.470003629")
    message(FATAL_ERROR "Incorrect displayed reference scores: ${cli_output}")
endif()
check_table(2)
file(WRITE "${WORK_DIR}/reference-output.txt" "${cli_output}")
run_cli(0 ${search} --query-id Q2 --k 1)
if(NOT cli_output MATCHES "103 +\\|")
    message(FATAL_ERROR "Query selection was ignored: ${cli_output}")
endif()
check_table(1)
run_cli(3 ${search} --query-id missing)
run_cli(2 ${search} --query-id Q1 --metric cosine)
run_cli(2 ${search} --query-id Q1 --ef-search 50)
run_cli(2 ${search} --query-id Q1 --bm25-k1 nan)
run_cli(2 ${search} --query-id Q1 --bm25-b 2)
run_cli(2 ${search} --query-id Q1 --k 0)
run_cli(2 ${search} --query-id Q1 --query-text radio)
run_cli(2 ${search} --mode vector)
run_cli(2 search --mode lexical --algorithm hnsw --dataset "${dataset}" --query "${query}")

run_cli(0 search --mode lexical --dataset "${dataset}" --query-text radio --bm25-k1 2 --bm25-b 0)
check_table(2)
run_cli(0 search --mode lexical --dataset "${dataset}" --query-text doesnotexist)
if(NOT cli_output MATCHES "Results returned: 0" OR NOT cli_output MATCHES "No matching documents")
    message(FATAL_ERROR "OOV query must report empty success: ${cli_output}")
endif()
check_table(0)
# Pass the empty argument directly: expanding a CMake list would drop it.
execute_process(COMMAND "${CLI_PATH}" search --mode lexical --dataset "${dataset}" --query-text ""
    RESULT_VARIABLE status OUTPUT_VARIABLE cli_output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT status EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "Empty text must be a valid query: ${status} ${errors}")
endif()
string(REPLACE "\r\n" "\n" cli_output "${cli_output}")
check_table(0)

# A dedicated properly escaped JSON fixture checks decoded text and escaped IDs.
file(WRITE "${dataset}" [=[{"document_id":"D|\n001","title":"motor \"E47\"","text":"C:\\logs"}
]=])
run_cli(0 search --mode lexical --dataset "${dataset}" --query-text E47)
check_table(1)
string(FIND "${cli_output}" [=[D\x7c\x0a001]=] escaped_id)
if(escaped_id LESS 0)
    message(FATAL_ERROR "Unsafe ID bytes were not escaped for the table: ${cli_output}")
endif()
file(WRITE "${dataset}" "{\"document_id\":\"D\",\"text\":\"first\",\"text\":\"second\"}\n")
run_cli(3 search --mode lexical --dataset "${dataset}" --query-text first)
if(NOT cli_error MATCHES "line 1.*JSON column")
    message(FATAL_ERROR "Missing JSON file/line/column diagnostic: ${cli_error}")
endif()

# Exercise every query in the checked-in text corpus. This validates wiring, not
# a relevance target; labels never choose results.
foreach(number RANGE 1 24)
    if(number LESS 10)
        set(qid "Q00${number}")
    else()
        set(qid "Q0${number}")
    endif()
    run_cli(0 search --algorithm bm25 --dataset "${CORPUS_DIR}/corpus.jsonl"
        --query "${CORPUS_DIR}/queries.jsonl" --query-id "${qid}" --k 10)
    if(NOT cli_output MATCHES "Documents indexed: 30" OR NOT cli_output MATCHES "Query ID: ${qid}")
        message(FATAL_ERROR "Actual corpus query ${qid} failed: ${cli_output}")
    endif()
    file(WRITE "${WORK_DIR}/${qid}.txt" "${cli_output}")
endforeach()
message(STATUS "BM25 executable: IDs, scores, tables, options, data errors, query selection and all 24 corpus queries passed.")

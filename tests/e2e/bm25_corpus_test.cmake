if(NOT DEFINED EVALUATOR_PATH OR NOT DEFINED DATA_DIR OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Evaluator, fixture and output paths are required")
endif()
execute_process(
    COMMAND "${EVALUATOR_PATH}" "${DATA_DIR}/documents.tsv" "${DATA_DIR}/queries.tsv" "${OUTPUT_DIR}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "BM25 regression evaluator failed: ${output}${error}")
endif()
file(READ "${OUTPUT_DIR}/summary.json" summary)
foreach(pair "documents;100" "queries;20" "hits_at_10;20")
    list(GET pair 0 key)
    list(GET pair 1 expected)
    string(JSON actual GET "${summary}" "${key}")
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "Regression fixture ${key}: expected ${expected}, got ${actual}")
    endif()
endforeach()
string(JSON scope GET "${summary}" scope)
if(NOT scope STREQUAL "preliminary_only_not_CP05_certification")
    message(FATAL_ERROR "Preliminary regression must not certify the official corpus")
endif()
file(READ "${OUTPUT_DIR}/rankings.csv" rankings)
if(NOT rankings MATCHES "query_id,rank,document_id,bm25_score")
    message(FATAL_ERROR "Top-10 rankings were not recorded")
endif()

# Exercise the evaluator as an input adapter, including uint32 validation,
# malformed UTF-8, duplicate IDs/queries and broken relevance references.
set(invalid_dir "${OUTPUT_DIR}/invalid")
file(MAKE_DIRECTORY "${invalid_dir}")
file(WRITE "${invalid_dir}/queries.tsv" "q1\t0\tword\n")
foreach(case duplicate_id overflow_id negative_id column_count malformed_utf8)
    if(case STREQUAL "duplicate_id")
        set(contents "0\tword\n0\tother\n")
    elseif(case STREQUAL "overflow_id")
        set(contents "4294967296\tword\n")
    elseif(case STREQUAL "negative_id")
        set(contents "-1\tword\n")
    elseif(case STREQUAL "malformed_utf8")
        string(ASCII 255 invalid_byte)
        set(contents "0\tword${invalid_byte}\n")
    else()
        set(contents "0\tword\textra\n")
    endif()
    file(WRITE "${invalid_dir}/documents.tsv" "${contents}")
    execute_process(COMMAND "${EVALUATOR_PATH}" "${invalid_dir}/documents.tsv"
        "${invalid_dir}/queries.tsv" "${invalid_dir}/rejected"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Evaluator accepted invalid case ${case}")
    endif()
endforeach()
file(WRITE "${invalid_dir}/documents.tsv" "0\tword\n")
foreach(contents "q1\t5\tword\n" "q1\t0\tword\nq1\t0\tword\n")
    file(WRITE "${invalid_dir}/queries.tsv" "${contents}")
    execute_process(COMMAND "${EVALUATOR_PATH}" "${invalid_dir}/documents.tsv"
        "${invalid_dir}/queries.tsv" "${invalid_dir}/rejected"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "Evaluator accepted an orphan label or duplicate query")
    endif()
endforeach()
message(STATUS "T12 regression: 100 synthetic technical documents, 20 queries; ${output}")

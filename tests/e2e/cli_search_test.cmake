cmake_minimum_required(VERSION 3.20)

include("${CMAKE_CURRENT_LIST_DIR}/cli_output_checks.cmake")

file(MAKE_DIRECTORY "${WORK_DIR}")
set(dataset "${WORK_DIR}/vectors with spaces.csv")
set(query "${WORK_DIR}/query with spaces.csv")
file(WRITE "${dataset}" "10,1,0\n20,0,1\n30,-1,0\n40,0.8,0.6\n")
file(WRITE "${query}" "1,0\n")
set(search search --dataset "${dataset}" --query "${query}" --algorithm brute-force)

function(run_cli expected_status)
    execute_process(
        COMMAND "${CLI_PATH}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors
        TIMEOUT 10
    )
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "CLI status ${status}, expected ${expected_status}: ${ARGN}\n${output}\n${errors}")
    endif()
    string(REPLACE "\r\n" "\n" output "${output}")
    if(expected_status EQUAL 0)
        if(NOT errors STREQUAL "")
            message(FATAL_ERROR "Successful CLI wrote to stderr: ${errors}")
        endif()
    elseif(NOT output STREQUAL "" OR errors STREQUAL "")
        message(FATAL_ERROR "Failed CLI must write only to stderr: ${output}\n${errors}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
    set(cli_error "${errors}" PARENT_SCOPE)
endfunction()

function(expect_error status diagnostic)
    run_cli("${status}" ${ARGN})
    if(NOT cli_error MATCHES "${diagnostic}")
        message(FATAL_ERROR "Expected diagnostic '${diagnostic}': ${cli_error}")
    endif()
endfunction()

run_cli(0 --help)
foreach(fragment "Usage:" "--dataset" "--query" "--algorithm" "--k" "--metric" "hnsw" "--ef-search" "--seed" "no persistence")
    if(NOT cli_output MATCHES "${fragment}")
        message(FATAL_ERROR "Help missing '${fragment}': ${cli_output}")
    endif()
endforeach()
if(cli_output MATCHES "not implemented|unavailable|reserved")
    message(FATAL_ERROR "Help must describe the available HNSW algorithm: ${cli_output}")
endif()
run_cli(0 search --help)
run_cli(0)

run_cli(0 ${search} --k 2)
foreach(fragment "Algorithm: BruteForce" "Distance metric: Cosine" "Vectors indexed: 4" "Dimensions: 2"
                 "Requested K: 2" "Results returned: 2" "Search completed successfully.")
    if(NOT cli_output MATCHES "${fragment}")
        message(FATAL_ERROR "Search output missing '${fragment}': ${cli_output}")
    endif()
endforeach()
check_search_output("${cli_output}" 2)
list(GET cli_rows 0 first)
parse_cli_row("${first}")
if(NOT cli_rank EQUAL 1 OR NOT cli_id EQUAL 10 OR NOT cli_distance STREQUAL "0.000000000")
    message(FATAL_ERROR "Incorrect card reference ranking: ${cli_output}")
endif()
list(GET cli_rows 1 second)
parse_cli_row("${second}")
if(NOT cli_rank EQUAL 2 OR NOT cli_id EQUAL 40 OR
   NOT cli_distance GREATER 0.19999 OR NOT cli_distance LESS 0.20001)
    message(FATAL_ERROR "Reference distance must satisfy abs(actual - 0.2) < 1e-5: ${second}")
endif()

run_cli(0 search --dataset "${dataset}" --query "${query}" --algorithm hnsw --k 4)
foreach(fragment "Algorithm: HNSW" "HNSW configuration: M=16 M0=32 efConstruction=100 efSearch=50 seed=42"
                 "Results returned: 4" "Index build time scope: graph construction only")
    if(NOT cli_output MATCHES "${fragment}")
        message(FATAL_ERROR "HNSW output missing '${fragment}': ${cli_output}")
    endif()
endforeach()
if(NOT cli_output MATCHES "Index build time \\(ms\\): [0-9]+\\.[0-9][0-9][0-9][0-9][0-9][0-9]\n")
    message(FATAL_ERROR "HNSW must display graph construction time separately: ${cli_output}")
endif()
check_search_output("${cli_output}" 4)
set(expected_ids 10 40 20 30)
set(expected_distances 0.000000000 0.199999988 1.000000000 2.000000000)
foreach(rank_index RANGE 0 3)
    list(GET cli_rows ${rank_index} row)
    parse_cli_row("${row}")
    list(GET expected_ids ${rank_index} expected_id)
    list(GET expected_distances ${rank_index} expected_distance)
    if(NOT cli_id STREQUAL expected_id OR NOT cli_distance STREQUAL expected_distance)
        message(FATAL_ERROR "HNSW must reproduce the small reference ranking and distance format: ${row}")
    endif()
endforeach()

foreach(k 1 5 10 20)
    run_cli(0 ${search} --k "${k}")
    if(k LESS 4)
        set(count "${k}")
    else()
        set(count 4)
    endif()
    if(NOT cli_output MATCHES "Results returned: ${count}\n")
        message(FATAL_ERROR "Incorrect result count for k=${k}: ${cli_output}")
    endif()
    check_search_output("${cli_output}" "${count}")
endforeach()
run_cli(0 ${search})
if(NOT cli_output MATCHES "Requested K: 10\n")
    message(FATAL_ERROR "Default k must be 10.")
endif()

# Direction and magnitude produce different rankings for these vectors.
file(WRITE "${dataset}" "0,10,0\n4294967295,1,1\n")
run_cli(0 ${search} --k 1)
check_search_output("${cli_output}" 1)
list(GET cli_rows 0 first)
parse_cli_row("${first}")
if(NOT cli_id STREQUAL "0" OR NOT cli_distance STREQUAL "0.000000000")
    message(FATAL_ERROR "Cosine must prefer the aligned vector: ${cli_output}")
endif()
run_cli(0 ${search} --k 1 --metric squared-euclidean)
check_search_output("${cli_output}" 1)
list(GET cli_rows 0 first)
parse_cli_row("${first}")
if(NOT cli_output MATCHES "Distance metric: SquaredEuclidean" OR
   NOT cli_id STREQUAL "4294967295" OR NOT cli_distance STREQUAL "1.000000000")
    message(FATAL_ERROR "Squared Euclidean must prefer the nearby vector: ${cli_output}")
endif()

# Fixed formatting must also expand the column for very large finite distances.
file(WRITE "${dataset}" "4294967295,1e19\n0,0\n")
file(WRITE "${query}" "0\n")
run_cli(0 ${search} --k 2 --metric squared-euclidean)
check_search_output("${cli_output}" 2)
list(GET cli_rows 1 second)
parse_cli_row("${second}")
if(NOT cli_id STREQUAL "4294967295" OR cli_distance LESS 9e37)
    message(FATAL_ERROR "Large finite distances must remain aligned without scientific notation: ${second}")
endif()
file(WRITE "${dataset}" "0,10,0\n4294967295,1,1\n")
file(WRITE "${query}" "1,0\n")

expect_error(2 "Unknown command" index)
expect_error(2 "Missing required option: --dataset" search --query "${query}" --algorithm brute-force)
expect_error(2 "Missing required option: --query" search --dataset "${dataset}" --algorithm brute-force)
expect_error(2 "Missing required option: --algorithm" search --dataset "${dataset}" --query "${query}")
expect_error(2 "Missing value" search --dataset --query "${query}")
expect_error(2 "Unknown option" ${search} --unknown value)
expect_error(2 "Repeated option" ${search} --k 1 --k 2)
foreach(k 0 -1 abc 1.5 999999999999999999999999999999)
    expect_error(2 "Invalid value for --k" ${search} --k "${k}")
endforeach()
expect_error(2 "Unknown algorithm" search --dataset "${dataset}" --query "${query}" --algorithm xyz)
expect_error(2 "Invalid --metric" ${search} --metric unknown)
# HNSW is available; missing files now follow the same input-data contract as exact search.
expect_error(3 "Cannot open" search --dataset "${WORK_DIR}/missing.csv"
             --query "${WORK_DIR}/missing-query.csv" --algorithm hnsw)
expect_error(3 "Cannot open" search --dataset "${WORK_DIR}/missing.csv" --query "${query}" --algorithm brute-force)
expect_error(3 "Cannot open" search --dataset "${dataset}" --query "${WORK_DIR}/missing.csv" --algorithm brute-force)

file(WRITE "${dataset}" "")
expect_error(3 "Dataset is empty" ${search})
file(WRITE "${dataset}" "10,1,0\n20,one,0\n")
expect_error(3 "line 2: column 2" ${search})
file(WRITE "${dataset}" "10,1,0\n10,0,1\n")
expect_error(3 "duplicate vector ID" ${search})
file(WRITE "${dataset}" "10,1,0\n20,1\n")
expect_error(3 "expected dimension" ${search})
file(WRITE "${dataset}" "10,1,0\n20,nan,0\n")
expect_error(3 "finite float" ${search})
file(WRITE "${dataset}" "10,1,0\n20,inf,0\n")
expect_error(3 "finite float" ${search})
file(WRITE "${dataset}" "10,1,0\n")
file(WRITE "${query}" "1,0,0\n")
expect_error(3 "query dimension mismatch" ${search})
file(WRITE "${query}" "")
expect_error(3 "Query file is empty" ${search})
file(WRITE "${query}" "1,0\n0,1\n")
expect_error(3 "exactly one embedding" ${search})
file(WRITE "${query}" "0,0\n")
expect_error(3 "all-zero query" ${search})
file(WRITE "${dataset}" "10,0,0\n")
expect_error(3 "all-zero embeddings" ${search})
run_cli(0 ${search} --metric squared-euclidean)

# Valid finite floats can still produce a squared distance too large for float.
file(WRITE "${dataset}" "10,3e38\n")
file(WRITE "${query}" "-3e38\n")
expect_error(4 "Error during search" ${search} --metric squared-euclidean)
message(STATUS "CLI help, exact/HNSW search, both metrics, k, error messages, streams and exit codes passed.")

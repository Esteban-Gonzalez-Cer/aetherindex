cmake_minimum_required(VERSION 3.20)
# Phases 3-4: quantized HNSW through the executable (vector, hybrid, batch) and the
# option rules. Exact results are covered by integration.quantization; here the full
# path must succeed, report its memory/re-rank settings and reject invalid combinations.
file(MAKE_DIRECTORY "${WORK_DIR}")
set(D "${SOURCE_DIR}/datasets")
execute_process(COMMAND "${GENERATOR_PATH}" "${WORK_DIR}/mvp" RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Fixture generation failed")
endif()

function(run_cli expected)
    execute_process(COMMAND "${CLI_PATH}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${output}\n${errors}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

function(require_text text)
    string(FIND "${cli_output}" "${text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing '${text}' in:\n${cli_output}")
    endif()
endfunction()

set(V --algorithm hnsw --dataset "${WORK_DIR}/mvp/vectors.csv" --query "${WORK_DIR}/mvp/query_2.csv" --k 10)
set(H --mode hybrid --dataset "${D}/hybrid/corpus.jsonl" --query "${D}/hybrid/queries.jsonl")
foreach(method ${METHODS})
    string(TOUPPER "${method}" label)
    run_cli(0 search ${V} --quantization ${method})
    require_text("Quantization: ${label} (codes ")
    require_text("FP32 rows kept)")
    require_text("Re-rank: exact FP32 over all candidates")
    require_text("Results returned: 10")
    # query_2's exact nearest neighbor is ID 7*97*2+10 = 1368 (fixture contract).
    if(NOT cli_output MATCHES "\\|    1 \\| +1368 \\| 0\\.0000")
        message(FATAL_ERROR "Re-ranked ${label} search lost the exact nearest neighbor:\n${cli_output}")
    endif()
    run_cli(0 search ${V} --quantization ${method} --rerank 20 --metric squared-euclidean)
    require_text("Re-rank: exact FP32 over 20 candidates")
    run_cli(0 search ${V} --quantization ${method} --drop-fp32)
    require_text("FP32 rows released)")
    require_text("Re-rank: none (approximate distances)")
    run_cli(0 search ${H} --query-id Q002 --quantization ${method} --drop-fp32 --rerank 0)
    require_text("Search mode: Hybrid")
    require_text("Results returned: 10")
    run_cli(0 search ${H} --all-queries --query-threads 4 --quantization ${method} --build-threads 4)
    require_text("Batch queries: 24")
    run_cli(2 search --algorithm brute-force --dataset "${D}/examples/vectors.csv" --query "${D}/examples/query.csv" --quantization ${method})
    run_cli(2 search ${V} --quantization ${method} --drop-fp32 --rerank 10)
    run_cli(2 search ${V} --quantization ${method} --rerank 5)
    run_cli(2 search ${H} --query-id Q001 --quantization ${method} --rerank 10)
    run_cli(2 search --mode lexical --dataset "${D}/corpus.jsonl" --query "${D}/queries.jsonl" --query-id Q001 --quantization ${method})
endforeach()
run_cli(2 search ${V} --rerank 10)
run_cli(2 search ${V} --drop-fp32)
run_cli(2 search ${V} --quantization sq8 --pq-subspaces 8)
run_cli(2 search ${V} --quantization fp16)
message(STATUS "Quantized CLI paths passed for: ${METHODS}")

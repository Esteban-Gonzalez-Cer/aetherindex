cmake_minimum_required(VERSION 3.20)
# CP-04 / KR1.5 through the executable: every checked-in hybrid query must complete the
# CLI -> SearchService -> QueryEngine (HNSW + BM25 + RRF) path and print a valid Top-K.
file(MAKE_DIRECTORY "${WORK_DIR}")
set(corpus "${DATA_DIR}/corpus.jsonl")
set(queries "${DATA_DIR}/queries.jsonl")

function(run_cli expected)
    execute_process(COMMAND "${CLI_PATH}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${output}\n${errors}")
    endif()
    string(REPLACE "\r\n" "\n" output "${output}")
    if(expected EQUAL 0)
        if(NOT errors STREQUAL "")
            message(FATAL_ERROR "Success wrote diagnostics: ${errors}")
        endif()
    elseif(NOT output STREQUAL "" OR errors STREQUAL "")
        message(FATAL_ERROR "Failure printed partial results or no error: ${output}\n${errors}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

function(require_text text)
    string(FIND "${cli_output}" "${text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing '${text}' in:\n${cli_output}")
    endif()
endfunction()

# Parse the fused table and check rank sequence, unique IDs and non-increasing RRF scores.
function(check_fused expected_rows)
    string(REPLACE "\n" ";" lines "${cli_output}")
    set(rows 0)
    set(ids "")
    set(previous "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^\\| +([0-9]+) \\| +([^ |]+) \\| +([0-9.]+) \\| +([0-9-]+) \\| +([0-9-]+) \\|$")
            math(EXPR rows "${rows}+1")
            if(NOT CMAKE_MATCH_1 EQUAL rows)
                message(FATAL_ERROR "Ranks are not consecutive: ${line}")
            endif()
            if("${CMAKE_MATCH_2}" IN_LIST ids)
                message(FATAL_ERROR "Duplicate fused document: ${line}")
            endif()
            list(APPEND ids "${CMAKE_MATCH_2}")
            if(CMAKE_MATCH_4 STREQUAL "-" AND CMAKE_MATCH_5 STREQUAL "-")
                message(FATAL_ERROR "Fused document came from neither retriever: ${line}")
            endif()
            # Fixed 12-decimal scores compare correctly as version strings.
            if(NOT previous STREQUAL "" AND CMAKE_MATCH_3 VERSION_GREATER previous)
                message(FATAL_ERROR "RRF scores are not sorted descending: ${line}")
            endif()
            set(previous "${CMAKE_MATCH_3}")
        endif()
    endforeach()
    if(NOT rows EQUAL expected_rows)
        message(FATAL_ERROR "Expected ${expected_rows} fused rows, got ${rows}:\n${cli_output}")
    endif()
endfunction()

file(STRINGS "${queries}" query_lines)
set(executed 0)
foreach(line IN LISTS query_lines)
    if(NOT line MATCHES "\"query_id\":\"([^\"]+)\"")
        continue()
    endif()
    set(id "${CMAKE_MATCH_1}")
    run_cli(0 search --mode hybrid --dataset "${corpus}" --query "${queries}" --query-id "${id}" --k 10)
    require_text("Search mode: Hybrid")
    require_text("Fusion: RRF (k_rrf=60)")
    require_text("Query ID: ${id}")
    require_text("Results returned: 10")
    require_text("| Rank | Document ID | RRF Score")
    check_fused(10)
    math(EXPR executed "${executed}+1")
endforeach()
if(executed LESS 20)
    message(FATAL_ERROR "KR1.5 requires at least 20 hybrid queries; found ${executed}.")
endif()

# Explicit --algorithm hnsw, custom fusion/candidate parameters and squared Euclidean.
run_cli(0 search --mode hybrid --algorithm hnsw --dataset "${corpus}" --query "${queries}"
    --query-id Q001 --k 3 --candidate-k 5 --rrf-k 10 --ef-search 64 --bm25-k1 1.5 --bm25-b 0.5
    --metric squared-euclidean)
require_text("Candidate K per retriever: 5")
require_text("Fusion: RRF (k_rrf=10)")
check_fused(3)

# Small fixture: K beyond the available documents and a query without lexical matches.
set(small "${WORK_DIR}/small.jsonl")
set(small_queries "${WORK_DIR}/small-queries.jsonl")
file(WRITE "${small}" "{\"document_id\":101,\"text\":\"motor e47\",\"embedding\":[1,0]}\n{\"document_id\":102,\"text\":\"bomba\",\"embedding\":[0,1]}\n")
file(WRITE "${small_queries}" "{\"query_id\":\"Q1\",\"query_text\":\"zzz\",\"embedding\":[1,0]}\n{\"query_id\":\"BAD\",\"query_text\":\"e47\",\"embedding\":[1,0,0]}\n")
run_cli(0 search --mode hybrid --dataset "${small}" --query "${small_queries}" --query-id Q1 --k 10)
require_text("Results returned: 2")
require_text("No lexical matches")
check_fused(2)

# Errors: data problems exit 3, invalid arguments exit 2, never partial output.
run_cli(3 search --mode hybrid --dataset "${small}" --query "${small_queries}" --query-id BAD)
run_cli(3 search --mode hybrid --dataset "${WORK_DIR}/missing.jsonl" --query "${small_queries}" --query-id Q1)
run_cli(3 search --mode hybrid --dataset "${DATA_DIR}/../corpus.jsonl" --query "${queries}" --query-id Q001)
run_cli(2 search --mode hybrid --dataset "${small}" --query-text e47)
run_cli(2 search --mode hybrid --algorithm brute-force --dataset "${small}" --query "${small_queries}" --query-id Q1)
run_cli(2 search --mode hybrid --algorithm bm25 --dataset "${small}" --query "${small_queries}" --query-id Q1)
run_cli(2 search --mode hybrid --dataset "${small}" --query "${small_queries}" --query-id Q1 --k 5 --candidate-k 4)
run_cli(2 search --mode hybrid --dataset "${small}" --query "${small_queries}" --query-id Q1 --rrf-k 0)
run_cli(2 search --mode lexical --dataset "${small}" --query "${small_queries}" --query-id Q1 --rrf-k 60)
run_cli(2 search --algorithm hnsw --dataset "${small}" --query "${small_queries}" --query-id Q1 --candidate-k 10)
message(STATUS "Hybrid CLI: ${executed} end-to-end queries passed")
